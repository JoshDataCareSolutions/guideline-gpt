# ---------------------------------------------------------------------------
# guideline-gpt configuration. Copy to `.env` and fill in your keys.
# ---------------------------------------------------------------------------

# LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# --- Anthropic (required if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI ---
# OPENAI_API_KEY is ALWAYS required (used for embeddings), and also for the LLM
# when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Reranker (local cross-encoder; downloaded on first use) ---
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Retrieval ---
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# --- Storage / paths ---
CHROMA_PERSIST_DIR=./chroma_db
DOCUMENTS_DIR=./documents
COLLECTION_NAME=guidelines

# --- Logging ---
LOG_LEVEL=INFO
